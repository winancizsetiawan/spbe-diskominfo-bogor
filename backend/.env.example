PORT=8080
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Konfigurasi PostgreSQL Lokal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spbe_bogor
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# Folder data Dasbor Publik/Analitik (dasborPublik.json, dasborInternal.json),
# dibuat oleh frontend/scripts/excel_dasbor_publik.py. Berisi data internal: jangan masuk git.
DASBOR_DATA_DIR=./data/dasbor

# Autentikasi:
#   demo     = hanya pengembangan lokal (token "demo.<peran>" diterima, plus token sesi portal).
#   lokal    = login di halaman portal; BE menerbitkan token sesi. ASN masuk dengan NIP + kata sandi TND.
#   keycloak = SSO Keycloak.
# Server menolak start bila AUTH_MODE=demo saat APP_ENV=production.
AUTH_MODE=demo

# Token sesi portal (mode lokal/demo). Produksi WAJIB diisi minimal 32 karakter acak, mis. hasil
#   openssl rand -hex 32
# Kosong saat pengembangan = rahasia acak (sesi gugur tiap restart).
SESI_SECRET=
SESI_DURASI_JAM=8

# Login ASN lewat akun TND Pemkot Bogor (username = NIP 18 digit). Kosongkan untuk mematikan.
TND_LOGIN_URL=https://tnd.kotabogor.go.id/api-baru/api/v1/login
TND_BATAS_WAKTU_DETIK=10
KEYCLOAK_ISSUER=https://sso.contoh.go.id/realms/spbe
KEYCLOAK_JWKS_URL=https://sso.contoh.go.id/realms/spbe/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=spbe-web

# Backup harian nyata (pg_dump + arsip folder unggahan). Folder backups/ tidak masuk git.
# Di Windows, isi PG_DUMP_PATH dengan jalur lengkap pg_dump.exe.
PG_DUMP_PATH=pg_dump
BACKUP_DIR=./backups
BACKUP_RETENSI=7
BACKUP_JAM=02:00
UPLOADS_DIR=./uploads

# Proxy tepercaya (mis. nginx di server yang sama) agar pembatas laju membaca IP klien sebenarnya.
# Kosong bila BE diakses langsung.
TRUSTED_PROXIES=

# Data contoh (user, aplikasi, dokumen, dll). Bawaan: aktif hanya saat APP_ENV=development.
# Di produksi biarkan false.
SEED_DATA=
